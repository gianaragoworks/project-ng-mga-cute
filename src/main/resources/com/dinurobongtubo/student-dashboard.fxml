<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinurobongtubo.StudentDashboardController"
            stylesheets="@student-dashboard.css"
            prefWidth="1100" prefHeight="700"
            styleClass="app-background">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="250" styleClass="sidebar">

            <!-- BRAND -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <Region prefWidth="24" prefHeight="24"
                        minWidth="24" minHeight="24"
                        styleClass="brand-mark"/>
                <Label text="HiramMate" styleClass="brand-name"/>
            </HBox>

            <!-- NAVIGATION -->
            <VBox spacing="5" styleClass="navigation">

                <Label text="STUDENT MENU" styleClass="menu-heading"/>

                <Button text="Dashboard"
                        onAction="#showDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button nav-button-active"/>

                <Button text="Browse Items"
                        onAction="#showBrowseItems"
                        styleClass="nav-button"
                        maxWidth="Infinity"/>

                <Button text="My Requests"
                        onAction="#showMyRequests"
                        styleClass="nav-button"
                        maxWidth="Infinity"/>

                <Button text="Borrowed &amp; Returns"
                onAction="#showBorrowedReturns"
                styleClass="nav-button"/>

                <Button text="Liabilities"
                onAction="#showLiabilities"
                styleClass="nav-button"/>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- STUDENT PROFILE -->
            <VBox styleClass="profile-container">
                <HBox spacing="10" alignment="CENTER_LEFT"
                      styleClass="profile-card">

                    <Label fx:id="profileInitials"
                           text="ST"
                           styleClass="profile-initials"/>

                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="profileName"
                               text="Student Name"
                               styleClass="profile-name"/>

                        <Label fx:id="profileDetails"
                               text="Student ID • Department"
                               styleClass="profile-details"/>
                    </VBox>

                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="main-scroll">

            <VBox spacing="28" styleClass="main-content">

                <!-- PAGE HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="15">

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Student dashboard"
                               styleClass="page-title"/>

                        <Label fx:id="welcomeLabel"
                               text="Welcome back! Track your campus equipment borrows and requests."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <TextField fx:id="dashboardSearchField"
                                   promptText="Search items..."
                                   prefWidth="190"
                                   styleClass="search-field"/>

                        <Button text="+ Borrow item"
                                onAction="#showComingSoon"
                                styleClass="primary-button"/>
                    </HBox>

                </HBox>

                <!-- SUMMARY CARDS -->
                <VBox spacing="18" styleClass="content-card">

                    <GridPane hgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                        </columnConstraints>

                        <VBox spacing="10" GridPane.columnIndex="0">
                            <Label text="Currently borrowed"
                                   styleClass="stat-label"/>
                            <Label fx:id="borrowedCount"
                                   text="0"
                                   styleClass="stat-value"/>
                        </VBox>

                        <VBox spacing="10" GridPane.columnIndex="1">
                            <Label text="Pending requests"
                                   styleClass="stat-label"/>
                            <Label fx:id="pendingCount"
                                   text="0"
                                   styleClass="stat-value"/>
                        </VBox>

                        <VBox spacing="10" GridPane.columnIndex="2">
                            <Label text="Overdue"
                                   styleClass="stat-label"/>
                            <Label fx:id="overdueCount"
                                   text="0"
                                   styleClass="stat-value"/>
                        </VBox>

                        <VBox spacing="10" GridPane.columnIndex="3">
                            <Label text="Reserved"
                                   styleClass="stat-label"/>
                            <Label fx:id="reservedCount"
                                   text="0"
                                   styleClass="stat-value"/>
                        </VBox>

                        <VBox spacing="10" GridPane.columnIndex="4">
                            <Label text="Liabilities"
                                   styleClass="stat-label"/>
                            <Label fx:id="liabilityAmount"
                                   text="₱0.00"
                                   styleClass="stat-value"/>
                        </VBox>

                    </GridPane>
                </VBox>

                <!-- ACTIVE BORROWS AND REQUESTS -->
                <VBox spacing="18" styleClass="content-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="My active borrows &amp; requests"
                               styleClass="section-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="View full history →"
                                onAction="#showComingSoon"
                                styleClass="text-button"/>
                    </HBox>

                    <!-- TABLE HEADER -->
                    <GridPane styleClass="table-header">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="17"/>
                            <ColumnConstraints percentWidth="18"/>
                        </columnConstraints>

                        <Label text="Item" GridPane.columnIndex="0"/>
                        <Label text="Category" GridPane.columnIndex="1"/>
                        <Label text="Due date" GridPane.columnIndex="2"/>
                        <Label text="Status" GridPane.columnIndex="3"/>
                        <Label text="Action" GridPane.columnIndex="4"/>
                    </GridPane>

                    <Separator/>

                    <Label fx:id="activeRecordsMessage"
                           text="No active borrows or pending requests yet."
                           styleClass="empty-message"/>

                </VBox>

                <!-- AVAILABLE ITEMS PREVIEW -->
                <VBox spacing="18" styleClass="content-card">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Available to borrow"
                                   styleClass="section-title"/>

                            <Label text="Popular campus equipment ready for reservation"
                                   styleClass="page-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="See all items →"
                                onAction="#showComingSoon"
                                styleClass="text-button"/>
                    </HBox>

                    <GridPane hgap="14" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0"
                              styleClass="item-preview-card">
                            <Label text="No items loaded"
                                   styleClass="item-name"/>
                            <Label text="Inventory will appear here."
                                   styleClass="item-description"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              styleClass="item-preview-card">
                            <Label text="No items loaded"
                                   styleClass="item-name"/>
                            <Label text="Inventory will appear here."
                                   styleClass="item-description"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2"
                              styleClass="item-preview-card">
                            <Label text="No items loaded"
                                   styleClass="item-name"/>
                            <Label text="Inventory will appear here."
                                   styleClass="item-description"/>
                        </VBox>

                        <VBox GridPane.columnIndex="3"
                              styleClass="item-preview-card">
                            <Label text="No items loaded"
                                   styleClass="item-name"/>
                            <Label text="Inventory will appear here."
                                   styleClass="item-description"/>
                        </VBox>

                    </GridPane>
                </VBox>

                <!-- BOTTOM ACTIONS -->
                <HBox spacing="12">
                    <Button text="Request an item"
                            onAction="#showComingSoon"
                            styleClass="primary-button"/>

                    <Button text="Browse catalog"
                            onAction="#showComingSoon"
                            styleClass="secondary-button"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
