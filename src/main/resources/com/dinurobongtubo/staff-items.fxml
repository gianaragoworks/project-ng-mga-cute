<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinurobongtubo.StaffItemsController"
            prefWidth="1100.0"
            prefHeight="700.0"
            stylesheets="@staff-items.css"
            styleClass="items-root">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="215.0"
              spacing="18.0"
              styleClass="sidebar">

            <padding>
                <Insets top="28" right="16" bottom="22" left="16"/>
            </padding>

            <VBox spacing="3.0">
                <Label text="HiramMate" styleClass="brand-title"/>
                <Label text="STAFF PORTAL" styleClass="brand-subtitle"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <Label text="WORKSPACE" styleClass="menu-heading"/>

            <Button text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Items"
                    onAction="#showItems"
                    maxWidth="Infinity"
                    styleClass="nav-button nav-active"/>

            <Button text="Requests"
                    onAction="#showRequests"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Borrowers &amp; Returns"
                    onAction="#showBorrowersReturns"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Liabilities"
                    onAction="#showLiabilities"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="4.0">
                <Label text="STAFF ACCOUNT" styleClass="menu-heading"/>

                <Label fx:id="staffNameLabel"
                       text="Staff Member"
                       styleClass="staff-name"/>

                <Label fx:id="staffIdLabel"
                       text="Staff ID"
                       styleClass="staff-id"/>
            </VBox>

            <Button text="Log Out"
                    onAction="#logout"
                    maxWidth="Infinity"
                    styleClass="logout-button"/>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="18.0" styleClass="main-area">

            <padding>
                <Insets top="25" right="28" bottom="24" left="28"/>
            </padding>

            <!-- HEADER -->
            <VBox spacing="5.0">
                <Label text="Items Management"
                       styleClass="page-title"/>

                <Label text="Manage your inventory, item conditions, and stock."
                       styleClass="page-subtitle"/>
            </VBox>

            <Separator/>

            <!-- SEARCH AND FILTER -->
            <VBox spacing="12.0" styleClass="section-card">

                <Label text="Inventory Overview"
                       styleClass="section-title"/>

                <HBox spacing="10.0" alignment="CENTER_LEFT">

                    <TextField fx:id="searchField"
                               promptText="Search item name, code, or category..."
                               HBox.hgrow="ALWAYS"
                               styleClass="search-field"/>

                    <ComboBox fx:id="categoryFilter"
                              prefWidth="180.0"
                              promptText="Category"
                              styleClass="category-filter"/>

                    <Button text="Refresh"
                            onAction="#refreshItems"
                            styleClass="refresh-button"/>

                </HBox>

                <Label fx:id="itemCountLabel"
                       text="0 item(s) found"
                       styleClass="item-count"/>

            </VBox>

            <!-- INVENTORY TABLE -->
            <VBox spacing="10.0"
                  styleClass="section-card"
                  VBox.vgrow="ALWAYS">

                <TableView fx:id="itemsTable"
                           VBox.vgrow="ALWAYS"
                           styleClass="data-table">

                    <columns>

                        <TableColumn fx:id="itemCodeColumn"
                                     text="Item Code"
                                     prefWidth="85"/>

                        <TableColumn fx:id="itemNameColumn"
                                     text="Item Name"
                                     prefWidth="145"/>

                        <TableColumn fx:id="categoryColumn"
                                     text="Category"
                                     prefWidth="100"/>

                        <TableColumn fx:id="conditionColumn"
                                     text="Condition"
                                     prefWidth="85"/>

                        <TableColumn fx:id="totalColumn"
                                     text="Total"
                                     prefWidth="55"/>

                        <TableColumn fx:id="availableColumn"
                                     text="Available"
                                     prefWidth="75"/>

                        <TableColumn fx:id="locationColumn"
                                     text="Pickup Location"
                                     prefWidth="125"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="115"/>

                    </columns>

                    <placeholder>
                        <Label text="No inventory items found."
                               styleClass="empty-message"/>
                    </placeholder>

                </TableView>

            </VBox>

            <!-- ACTION BUTTONS -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">

                <Button text="+ Add Item"
                        onAction="#addItem"
                        styleClass="primary-button"/>

                <Button text="Update Item"
                        onAction="#editItem"
                        styleClass="outline-button"/>

                <Button text="Remove Item"
                        onAction="#removeItem"
                        styleClass="neutral-button"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>
