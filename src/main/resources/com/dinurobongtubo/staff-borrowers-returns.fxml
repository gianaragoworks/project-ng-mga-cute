<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinurobongtubo.StaffBorrowersReturnsController"
            stylesheets="@staff-borrowers-returns.css"
            prefWidth="1200" prefHeight="760"
            styleClass="page">

    <left>
        <VBox prefWidth="230" spacing="20" styleClass="sidebar">
            <padding>
                <Insets top="28" right="18" bottom="22" left="18"/>
            </padding>

            <VBox spacing="5">
                <Label text="HiramMate" styleClass="brand"/>
                <Label text="STAFF PORTAL" styleClass="brand-subtitle"/>
            </VBox>

            <Separator/>

            <VBox spacing="8">
                <Label text="MAIN MENU" styleClass="menu-heading"/>

                <Button text="Dashboard" onAction="#showDashboard"
                        styleClass="nav-button"/>

                <Button text="Items Management" onAction="#showItems"
                        styleClass="nav-button"/>

                <Button text="Requests" onAction="#showRequests"
                        styleClass="nav-button"/>

                <Button text="Borrowers &amp; Returns"
                        styleClass="nav-button, nav-button-active"/>

                <Button text="Liabilities" onAction="#showLiabilities"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="6">
                <Label text="SIGNED IN AS" styleClass="menu-heading"/>
                <Label fx:id="staffNameLabel" text="Staff Name"
                       styleClass="staff-name"/>
                <Label fx:id="staffIdLabel" text="Staff ID"
                       styleClass="staff-id"/>
                <Button text="Log Out" onAction="#logout"
                        styleClass="logout-button" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="22" styleClass="main-content">
            <padding>
                <Insets top="30" right="32" bottom="30" left="32"/>
            </padding>

            <VBox spacing="6">
                <Label text="Borrowers &amp; Returns"
                       styleClass="page-title"/>
                <Label text="Monitor active borrowers and process returned items."
                       styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="8" styleClass="summary-card">
                    <Label text="ACTIVE BORROWERS" styleClass="summary-label"/>
                    <Label fx:id="activeCountLabel" text="0"
                           styleClass="summary-number"/>
                </VBox>

                <VBox spacing="8" styleClass="summary-card">
                    <Label text="OVERDUE RETURNS" styleClass="summary-label"/>
                    <Label fx:id="overdueCountLabel" text="0"
                           styleClass="summary-number-danger"/>
                </VBox>
            </HBox>

            <VBox spacing="14" styleClass="table-card">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Borrow Records" styleClass="section-title"/>
                        <Label text="Select a record to process its return."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Button text="Refresh" onAction="#loadBorrowRecords"
                            styleClass="secondary-button"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField"
                               promptText="Search borrower, student ID, item..."
                               HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="filterComboBox"
                              prefWidth="160"
                              promptText="Filter status"/>
                </HBox>

                <TableView fx:id="borrowersTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="390">

                    <columns>
                        <TableColumn fx:id="recordIdColumn"
                                     text="Record ID" prefWidth="85"/>

                        <TableColumn fx:id="borrowerColumn"
                                     text="Borrower" prefWidth="145"/>

                        <TableColumn fx:id="studentIdColumn"
                                     text="Student ID" prefWidth="105"/>

                        <TableColumn fx:id="itemColumn"
                                     text="Item" prefWidth="140"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Qty" prefWidth="55"/>

                        <TableColumn fx:id="borrowDateColumn"
                                     text="Borrow Date" prefWidth="105"/>

                        <TableColumn fx:id="dueDateColumn"
                                     text="Due Date" prefWidth="105"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status" prefWidth="95"/>
                    </columns>

                    <placeholder>
                        <Label text="No borrow records found."/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Label text="Select a record before processing a return."
                           styleClass="helper-text"/>
                    <Button text="Process Return"
                            onAction="#processReturn"
                            styleClass="primary-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
