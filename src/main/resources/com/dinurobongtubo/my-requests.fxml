<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/27"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.dinurobongtubo.MyRequestsController"
    stylesheets="@my-requests.css"
    styleClass="root">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" styleClass="sidebar">

            <VBox spacing="25">

                <!-- BRAND -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Region prefWidth="22"
                            prefHeight="22"
                            styleClass="brand-square"/>

                    <Label text="HiramMate"
                           styleClass="brand-name"/>
                </HBox>

                <!-- NAVIGATION -->
                <VBox spacing="5">

                    <Button text="Dashboard"
                            onAction="#showDashboard"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="Browse Items"
                            onAction="#showBrowseItems"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="My Requests"
                            styleClass="nav-button nav-button-active"
                            maxWidth="Infinity"/>

                    <Button text="Borrowed &amp; Returns"
                            onAction="#showBorrowedReturns"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="Liabilities"
                            onAction="#showLiabilities"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- STUDENT PROFILE -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="profile-card">

                <Label fx:id="profileInitials"
                       text="ST"
                       styleClass="profile-initials"/>

                <VBox spacing="3" HBox.hgrow="ALWAYS">

                    <Label fx:id="profileName"
                           text="Student Name"
                           styleClass="profile-name"/>

                    <Label fx:id="profileDetails"
                           text="Student ID"
                           styleClass="profile-details"/>

                </VBox>

                <Label text="●"
                       styleClass="online-indicator"/>

            </HBox>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="main-scroll">

            <VBox spacing="25"
                  styleClass="main-content">

                <!-- PAGE HEADER -->
                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="5">

                        <Label text="My Requests"
                               styleClass="page-title"/>

                        <Label text="Track approval progress, pickup schedules, and past borrow requests."
                               styleClass="page-subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="+ New Request"
                            onAction="#showBrowseItems"
                            styleClass="primary-button"/>

                </HBox>

                <!-- REQUESTS PANEL -->
                <VBox spacing="18"
                      styleClass="requests-panel">

                    <!-- STATUS FILTERS -->
                    <HBox spacing="8"
                          alignment="CENTER_LEFT"
                          styleClass="filter-row">

                        <Button text="All Requests"
                                onAction="#showAllRequests"
                                styleClass="request-filter request-filter-active"/>

                        <Button text="Pending"
                                onAction="#showPendingRequests"
                                styleClass="request-filter"/>

                        <Button text="Reserved"
                                onAction="#showReservedRequests"
                                styleClass="request-filter"/>

                        <Button text="Approved"
                                onAction="#showApprovedRequests"
                                styleClass="request-filter"/>

                        <Button text="Returned / Cancelled"
                                onAction="#showClosedRequests"
                                styleClass="request-filter"/>

                    </HBox>

                    <!-- SEARCH FIELD -->
                    <TextField fx:id="searchField"
                               promptText="Search by request ID or item name..."
                               styleClass="search-field"/>

                    <!-- REQUESTS TABLE -->
                    <TableView fx:id="requestsTable"
                               prefHeight="420"
                               styleClass="requests-table">

                        <columns>

                            <TableColumn fx:id="requestIdColumn"
                                         text="Request ID"
                                         prefWidth="105"/>

                            <TableColumn fx:id="itemColumn"
                                         text="Item"
                                         prefWidth="150"/>

                            <TableColumn fx:id="purposeColumn"
                                         text="Purpose"
                                         prefWidth="190"/>

                            <TableColumn fx:id="pickupDateColumn"
                                         text="Pickup Date"
                                         prefWidth="105"/>

                            <TableColumn fx:id="dueDateColumn"
                                         text="Due Date"
                                         prefWidth="100"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="110"/>

                            <TableColumn fx:id="actionColumn"
                                         text="Action"
                                         prefWidth="90"/>

                        </columns>

                    </TableView>

                    <!-- TABLE FOOTER -->
                    <HBox alignment="CENTER_LEFT">

                        <Label fx:id="tableFooterLabel"
                               text="Showing 0 requests"
                               styleClass="table-footer"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="tableCountLabel"
                               text="0 - 0 of 0"
                               styleClass="table-footer"/>

                    </HBox>

                </VBox>

            </VBox>

        </ScrollPane>
    </center>

</BorderPane>
